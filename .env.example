# Environment Variables - Example
# Copy this file to .env.local and fill in your actual API keys
# NEVER commit .env.local to GitHub - it contains sensitive data

# AI Models (Gemini / Groq / OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Places API (PlacesProvider for real hotel, restaurant & attraction verification)
# Get from: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# SerpApi Key (Live Google Flights & Google Hotels Search Engine, Reddit Fallback)
# Get from: https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Reddit API OAuth (App-only client credentials)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Supabase (Optional short links backing)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Live Flights Providers
DUFFEL_API_KEY=your_duffel_api_key_here
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Live Trains Provider
RAPIDAPI_KEY=your_rapidapi_key_here

# Pixabay API Key (Images)
# Get from: https://pixabay.com/api/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Convex Database
# Get from: https://convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=your-deployment-id

# Arcjet Rate Limiting
# Get from: https://www.arcjet.com
ARCJET_KEY=your_arcjet_key_here
ARCJET_ENV=development

# Clerk Authentication
# Get from: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Optional: Clerk Redirect URLs (for OAuth)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Blog Content API Integration (Optional)
NEWS_API_KEY=your_newsapi_key_here